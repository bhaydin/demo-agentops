@implements IDisposable
@inject LeagueStateFeed Feed
@inject LeagueStateClient League
@inject ILogger<ApprovalDialog> Logger

@if (Pending is { } pending)
{
    <div class="overlay">
        <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="approval-title">
            <h2 id="approval-title">Coach wants to act</h2>
            <p class="summary">@pending.Summary</p>
            <dl class="facts">
                <dt>Tool</dt>
                <dd><code>@pending.Tool</code></dd>
                <dt>Acting as</dt>
                <dd>@pending.CallerScope, franchise @pending.EffectiveFranchiseId</dd>
                <dt>Arguments</dt>
                <dd><pre>@Pretty(pending.Arguments)</pre></dd>
                <dt>Requested</dt>
                <dd>@pending.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss")</dd>
            </dl>
            @if (_error is not null)
            {
                <p class="error">@_error</p>
            }
            <div class="actions">
                <button class="deny" type="button" disabled="@_busy" @onclick="() => DecideAsync(pending.Id, false)">Deny</button>
                <button class="approve" type="button" disabled="@_busy" @onclick="() => DecideAsync(pending.Id, true)">Approve</button>
            </div>
        </div>
    </div>
}
@if (_notice is not null)
{
    <div class="toast" role="status" @onclick="() => _notice = null">@_notice</div>
}

@code {
    private bool _busy;
    private string? _error;
    private string? _notice;

    private PendingApproval? Pending => Feed.Current.PendingConfirmations.FirstOrDefault();

    protected override void OnInitialized() => Feed.Changed += OnFeedChanged;

    private void OnFeedChanged() => _ = InvokeAsync(StateHasChanged);

    // Nothing thrown here may escape: an unhandled event exception ends the circuit, and with it
    // the chat and the ticker in the middle of the approval demo (Codex Phase 6).
    private async Task DecideAsync(string id, bool approve)
    {
        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            var result = await League.DecideAsync(id, approve, CancellationToken.None);
            if (result.Outcome is { } outcome)
            {
                var detail = outcome.Error is null ? "" : $": {outcome.Error}";
                _notice = result.Reconciled
                    ? $"The call did not confirm, but the league recorded the action as {outcome.Status}{detail}."
                    : $"{(approve ? "Approved" : "Denied")}: {outcome.Status}{detail}";
            }
            else
            {
                _error = $"Could not confirm the decision ({result.Error}). The action is still pending; try again.";
            }

            await Feed.RefreshAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Deciding confirmation {ConfirmationId} failed.", id);
            _error = $"Unexpected error: {ex.Message}. The action may still be pending; the ticker shows the league's record.";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Pretty(System.Text.Json.JsonElement arguments)
        => System.Text.Json.JsonSerializer.Serialize(arguments, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });

    public void Dispose() => Feed.Changed -= OnFeedChanged;
}
