@using System.Text.RegularExpressions
@implements IDisposable
@inject CoachConversation Conversation
@inject LeagueStateFeed Feed

<div class="chat">
    <div class="chat-head">
        @if (Conversation.BoundVersion is { } bound)
        {
            <span class="muted">Conversation with <strong>@CoachConversation.Describe(bound)</strong></span>
        }
        else
        {
            <span class="muted">Your next message starts a conversation with whichever Coach version is routed.</span>
        }
    </div>
    <div class="messages">
        @if (Conversation.Entries.Count == 0)
        {
            <p class="muted intro">Ask Coach about your lineup, an injury, a trade offer, or a waiver move.</p>
        }
        @foreach (var entry in Conversation.Entries)
        {
            <div class="msg @entry.Role">
                <div class="bubble">@Render(entry.Text)</div>
            </div>
        }
        @if (Conversation.Thinking)
        {
            <div class="msg assistant">
                <div class="bubble thinking">Coach is thinking…</div>
            </div>
        }
    </div>
    @if (Conversation.Error is not null)
    {
        <p class="error">@Conversation.Error</p>
    }
    <form class="composer" @onsubmit="SendAsync">
        <input @bind="_draft" @bind:event="oninput" placeholder="Message Coach" aria-label="Message Coach" disabled="@Conversation.Busy" />
        <button type="submit" disabled="@(Conversation.Busy || string.IsNullOrWhiteSpace(_draft))">Send</button>
    </form>
</div>

@code {
    private static readonly Regex Bold = new(@"\*\*(.+?)\*\*", RegexOptions.Compiled);

    private readonly CancellationTokenSource _gone = new();
    private string _draft = "";

    protected override void OnInitialized()
    {
        Conversation.Changed += OnConversationChanged;
        Feed.Changed += OnFeedChanged;
    }

    private void OnConversationChanged() => _ = InvokeAsync(StateHasChanged);

    // Every poll: if the endpoint was re-routed, end the session so the next message goes to the
    // version the header shows.
    private void OnFeedChanged() => _ = InvokeAsync(async () =>
    {
        if (await Conversation.SyncVersionAsync(_gone.Token))
        {
            StateHasChanged();
        }
    });

    private async Task SendAsync()
    {
        var text = _draft;
        _draft = "";
        await Conversation.SendAsync(text, _gone.Token);
    }

    // The Coach answers in light markdown. Encode everything, then allow bold; line breaks are
    // preserved by the bubble's white-space rule.
    private static MarkupString Render(string text)
    {
        var encoded = System.Net.WebUtility.HtmlEncode(text);
        return new MarkupString(Bold.Replace(encoded, "<strong>$1</strong>"));
    }

    public void Dispose()
    {
        Conversation.Changed -= OnConversationChanged;
        Feed.Changed -= OnFeedChanged;
        _gone.Cancel();
        _gone.Dispose();
    }
}
