<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <UserSecretsId>1d620a33-af4e-451a-a9ff-81ba3f21d9bb</UserSecretsId>
    <!-- Microsoft.Agents.AI.Foundry (AsAIAgent over a hosted agent endpoint) is preview API. -->
    <NoWarn>$(NoWarn);MAAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Chat: the deployed Coach through its Foundry agent endpoint; header: routed version. -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry" />
    <PackageReference Include="Azure.Identity" />
    <!-- The demo admin key (vault secret Mcp/DemoAdminKey) comes through Key Vault configuration. -->
    <PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.Exporter" />
  </ItemGroup>

</Project>
