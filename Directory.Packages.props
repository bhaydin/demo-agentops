<Project>

  <!--
    Central Package Management. Exact versions only; no floating or wildcard versions.
    Versions verified 2026-09-27 against nuget.org and Microsoft Learn (see docs/BUILD-PLAN.md, Phase 0 record).
    Frozen after Phase 4 unless the maintainer approves a bump.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Microsoft Agent Framework">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.22.0" />
    <!-- Prerelease: contains FoundryEvals. Foundry.Hosting depends on this exact version. -->
    <PackageVersion Include="Microsoft.Agents.AI.Foundry" Version="1.22.0-preview.260918.1" />
    <!-- Prerelease: AddFoundryResponses / MapFoundryResponses. No stable release exists. -->
    <PackageVersion Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.22.0-preview.260918.1" />
  </ItemGroup>

  <ItemGroup Label="Azure">
    <!-- Prerelease: matches the version Microsoft.Agents.AI.Foundry 1.22.0-preview depends on. -->
    <PackageVersion Include="Azure.AI.Projects" Version="3.0.0-beta.2" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <!-- Key Vault configuration provider: a double dash in a secret name maps to a ":" config section. -->
    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions (class libraries; apps get these from the shared framework)">
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="MCP C# SDK">
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup Label="OpenTelemetry">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.19.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <!-- Azure: traces to Application Insights (Phase 4). The Coach hosted runtime carries its own copy (transitive, 1.7.0). -->
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.Exporter" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <!-- VSTest mode so `dotnet test tests/<project>` works as written in AGENTS.md. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- In-process ASP.NET Core host for MCP server integration tests (Phase 2). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

</Project>
